{
  "entities": {
    "TripRoom": {
      "title": "TripRoom",
      "description": "Invite-code-gated family Europe trip room accessible without login",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "pattern": "^[A-Z0-9]{6,12}$", "minLength": 6, "maxLength": 12 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subtitle": { "type": "string", "minLength": 0, "maxLength": 160 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "title", "subtitle", "startDate", "endDate", "ownerId", "createdAt", "updatedAt"]
    },
    "JoinedTrip": {
      "title": "JoinedTrip",
      "description": "Per-user reference to created or joined trip rooms",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "pattern": "^[A-Z0-9]{6,12}$", "maxLength": 12 },
        "tripTitle": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["owner", "editor", "viewer"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "tripTitle", "role", "joinedAt"]
    },
    "Traveler": {
      "title": "Traveler",
      "description": "Six family travelers and their real-time GPS locations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "relation": { "type": "string", "minLength": 1, "maxLength": 40 },
        "ageGroup": { "type": "string", "enum": ["kid", "adult", "senior"] },
        "markerColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "maxLength": 7 },
        "avatarInitial": { "type": "string", "minLength": 1, "maxLength": 4 },
        "isSharingLocation": { "type": "boolean" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "currentPlaceLabel": { "type": "string", "maxLength": 100 },
        "statusNote": { "type": "string", "maxLength": 80 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "relation", "ageGroup", "markerColor", "avatarInitial", "isSharingLocation", "lat", "lng", "accuracyMeters", "currentPlaceLabel", "statusNote", "updatedAt"]
    },
    "ItineraryItem": {
      "title": "ItineraryItem",
      "description": "Shared daily itinerary item with kid and adult recommendation tags",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "dayIndex": { "type": "number" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "startTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "maxLength": 5 },
        "endTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "maxLength": 5 },
        "city": { "type": "string", "minLength": 1, "maxLength": 50 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["landmark", "food", "cafe", "museum", "activity", "shopping", "transit", "lodging"] },
        "placeId": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 200 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "tags": { "type": "array", "description": "Bounded up to 8 recommendation tags" },
        "walkingLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "memo": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["planned", "visited", "skipped"] },
        "likedBy": { "type": "array", "description": "Bounded up to 10 traveler IDs" },
        "updatedByName": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "dayIndex", "date", "startTime", "endTime", "city", "title", "category", "placeId", "address", "lat", "lng", "tags", "walkingLevel", "memo", "status", "likedBy", "updatedByName", "createdAt", "updatedAt"]
    },
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "Photo travel journal entry showing meals, places, and memories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "dayIndex": { "type": "number" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "timeLabel": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "maxLength": 5 },
        "city": { "type": "string", "minLength": 1, "maxLength": 50 },
        "placeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mealOrActivity": { "type": "string", "minLength": 1, "maxLength": 120 },
        "entryType": { "type": "string", "enum": ["meal", "spot", "moment"] },
        "story": { "type": "string", "minLength": 1, "maxLength": 800 },
        "photoUrl": { "type": "string", "maxLength": 250000 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "withTravelers": { "type": "array", "description": "Bounded up to 10 traveler IDs" },
        "tags": { "type": "array", "description": "Bounded up to 8 tags" },
        "authorName": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "dayIndex", "date", "timeLabel", "city", "placeName", "mealOrActivity", "entryType", "story", "photoUrl", "lat", "lng", "withTravelers", "tags", "authorName", "createdAt", "updatedAt"]
    },
    "WishlistPlace": {
      "title": "WishlistPlace",
      "description": "Family wishlist place with kid/adult tags and voting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "city": { "type": "string", "minLength": 1, "maxLength": 50 },
        "placeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "googlePlaceId": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 200 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "category": { "type": "string", "enum": ["landmark", "food", "cafe", "museum", "activity", "shopping"] },
        "tags": { "type": "array", "description": "Bounded up to 8 tags" },
        "reason": { "type": "string", "maxLength": 300 },
        "suggestedBy": { "type": "string", "maxLength": 40 },
        "votedBy": { "type": "array", "description": "Bounded up to 10 traveler IDs" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "city", "placeName", "googlePlaceId", "address", "lat", "lng", "category", "tags", "reason", "suggestedBy", "votedBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/joinedTrips/{inviteCode}": {
      "schema": { "$ref": "#/entities/JoinedTrip" },
      "description": "Organizer's list of created or saved trip rooms"
    },
    "/tripRooms/{inviteCode}": {
      "schema": { "$ref": "#/entities/TripRoom" },
      "description": "Invite-code-keyed family trip workspace accessible without login"
    },
    "/tripRooms/{inviteCode}/travelers/{travelerId}": {
      "schema": { "$ref": "#/entities/Traveler" },
      "description": "Six family travelers and their real-time GPS coordinates"
    },
    "/tripRooms/{inviteCode}/itineraryItems/{itemId}": {
      "schema": { "$ref": "#/entities/ItineraryItem" },
      "description": "Shared daily itinerary items with kid and adult tags"
    },
    "/tripRooms/{inviteCode}/diaryEntries/{entryId}": {
      "schema": { "$ref": "#/entities/DiaryEntry" },
      "description": "Photo travel journal entries for meals, places, and daily memories"
    },
    "/tripRooms/{inviteCode}/wishlistPlaces/{placeId}": {
      "schema": { "$ref": "#/entities/WishlistPlace" },
      "description": "Candidate places with family voting and preference tags"
    }
  }
}
